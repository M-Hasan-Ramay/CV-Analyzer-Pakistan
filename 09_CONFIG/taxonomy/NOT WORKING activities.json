def main():
    if not ACTIVITIES_FILE.exists():
        raise FileNotFoundError(
            f"Could not find {ACTIVITIES_FILE}\n"
            "Save this script as C:\\CV_AI\\app\\taxonomy_activity_enrich.py "
            "and run it from C:\\CV_AI."
        )

    with ACTIVITIES_FILE.open("r", encoding="utf-8-sig") as f:
        data = json.load(f)

    if not isinstance(data, dict) or not isinstance(data.get("activities"), list):
        raise ValueError("Expected a JSON object containing an 'activities' list.")

    records = data["activities"]
    by_id = {}
    for record in records:
        if not isinstance(record, dict) or not isinstance(record.get("id"), str):
            raise ValueError("Found an activity record without a valid string ID.")
        if record["id"] in by_id:
            raise ValueError(f"Duplicate activity ID found: {record['id']}")
        by_id[record["id"]] = record

    missing = sorted(set(UPDATES) - set(by_id))
    if missing:
        raise ValueError(
            "These expected generated IDs were not found; no file was changed:\n"
            + "\n".join(missing)
        )

    # Refuse to overwrite any record that no longer looks like a generated placeholder.
    unexpected = []
    for activity_id in UPDATES:
        record = by_id[activity_id]
        if record.get("generated_by") != "taxonomy_repair.py":
            unexpected.append(f"{activity_id}: generated_by is not taxonomy_repair.py")
        if record.get("review_status") != "GENERATED_NEEDS_REVIEW":
            unexpected.append(f"{activity_id}: review_status is not GENERATED_NEEDS_REVIEW")
    if unexpected:
        raise ValueError(
            "Some records do not match the expected review state; no file was changed:\n"
            + "\n".join(unexpected)
        )

    stamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    backup_dir = BACKUP_DIR / f"taxonomy_activity_enrich_{stamp}"
    backup_dir.mkdir(parents=True, exist_ok=False)
    shutil.copy2(ACTIVITIES_FILE, backup_dir / "activities.json")

    changes = []
    for activity_id, proposed in UPDATES.items():
        record = by_id[activity_id]
        old_name = record.get("name")
        old_description = record.get("description")
        old_aliases = record.get("aliases", [])

        # Preserve existing aliases and append unique additions, case-insensitively.
        aliases = list(old_aliases) if isinstance(old_aliases, list) else []
        seen = {str(alias).strip().casefold() for alias in aliases if str(alias).strip()}
        for alias in proposed["aliases"]:
            key = alias.strip().casefold()
            if key and key not in seen:
                aliases.append(alias)
                seen.add(key)

        record["name"] = proposed["name"]
        record["description"] = proposed["description"]
        record["aliases"] = aliases
        # Deliberately retain review_status, generated_by, category, branch, and id.

        changes.append({
            "id": activity_id,
            "old_name": old_name,
            "new_name": proposed["name"],
            "description_replaced": old_description != proposed["description"],
            "aliases_added": proposed["aliases"],
            "review_status_retained": record.get("review_status"),
            "category_retained": record.get("category"),
            "branch_retained": record.get("branch"),
        })

    temp_file = ACTIVITIES_FILE.with_suffix(".json.tmp")
    with temp_file.open("w", encoding="utf-8", newline="\n") as f:
        json.dump(data, f, ensure_ascii=False, indent=4)
        f.write("\n")

    # Re-open and validate the exact output before replacing the original.
    with temp_file.open("r", encoding="utf-8") as f:
        check = json.load(f)
    if len(check["activities"]) != len(records):
        temp_file.unlink(missing_ok=True)
        raise ValueError("Record count changed during validation; original left untouched.")

    check_ids = [r["id"] for r in check["activities"]]
    original_ids = [r["id"] for r in records]
    if check_ids != original_ids:
        temp_file.unlink(missing_ok=True)
        raise ValueError("Activity ID order or IDs changed; original left untouched.")

    shutil.move(str(temp_file), str(ACTIVITIES_FILE))

    REPORT_DIR.mkdir(parents=True, exist_ok=True)
    report_file = REPORT_DIR / "taxonomy_activity_enrich_report.txt"
    with report_file.open("w", encoding="utf-8", newline="\n") as f:
        f.write("TAXONOMY ACTIVITY ENRICHMENT REPORT\n")
        f.write(f"Timestamp: {stamp}\n")
        f.write(f"File updated: {ACTIVITIES_FILE}\n")
        f.write(f"Backup: {backup_dir / 'activities.json'}\n")
        f.write(f"Records enriched: {len(changes)}\n")
        f.write("IDs, category, branch, and review_status were preserved.\n")
        f.write("No record was marked approved.\n\n")
        for item in changes:
            f.write(f"{item['id']}\n")
            f.write(f"  Name: {item['old_name']} -> {item['new_name']}\n")
            f.write(f"  Category retained: {item['category_retained']}\n")
            f.write(f"  Branch retained: {item['branch_retained']}\n")
            f.write(f"  Review status retained: {item['review_status_retained']}\n")
            f.write(f"  Aliases proposed: {', '.join(item['aliases_added'])}\n\n")

    print("Activity enrichment completed.")
    print(f"Records enriched: {len(changes)}")
    print(f"Backup: {backup_dir}")
    print(f"Report: {report_file}")
    print("All 70 records remain GENERATED_NEEDS_REVIEW.")
    print("Next: run the taxonomy validator and loader tests.")
    

if __name__ == "__main__":
    main()
